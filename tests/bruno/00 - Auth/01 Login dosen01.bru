meta {
  name: 01 Login dosen01
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Device-ID: DEV-DOSEN-01
}

body:json {
  {
    "username": "dosen01",
    "password": "Dosen123!"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("ada access_token", function () {
    expect(res.getBody().access_token).to.be.a("string");
  });
}

script:post-response {
  bru.setVar("dosenToken", res.body.access_token);
  bru.setVar("dosenRefresh", res.body.refresh_token);
}
