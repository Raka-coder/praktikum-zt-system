meta {
  name: 03 Login admin01
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Device-ID: DEV-ADMIN-01
}

body:json {
  {
    "username": "admin01",
    "password": "Admin123!"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

script:post-response {
  bru.setVar("adminToken", res.body.access_token);
  bru.setVar("adminRefresh", res.body.refresh_token);
}
