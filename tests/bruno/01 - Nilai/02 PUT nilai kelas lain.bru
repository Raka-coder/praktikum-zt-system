meta {
  name: 02 PUT nilai kelas lain (ditolak)
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/nilai/{{nilaiIdOther}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Device-ID: DEV-DOSEN-01
}

auth:bearer {
  token: {{dosenToken}}
}

body:json {
  {
    "angka": 95
  }
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
  test("alasan kepemilikan kelas", function () {
    expect(res.getBody().reason).to.contain("bukan diampu");
  });
}
