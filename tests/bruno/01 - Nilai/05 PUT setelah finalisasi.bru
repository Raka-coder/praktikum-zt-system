meta {
  name: 05 PUT setelah finalisasi (ditolak)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/nilai/{{nilaiIdOwn}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Device-ID: DEV-DOSEN-01
}

auth:bearer {
  token: {{dosenToken}}
}

body:json {
  {
    "angka": 70
  }
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
  test("alasan kelas final", function () {
    expect(res.getBody().reason).to.contain("difinalisasi");
  });
}
