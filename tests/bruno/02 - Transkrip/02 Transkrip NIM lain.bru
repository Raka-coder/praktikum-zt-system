meta {
  name: 02 Transkrip NIM lain (ditolak)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/transkrip/{{nimOther}}
  body: none
  auth: bearer
}

headers {
  X-Device-ID: DEV-MHS-01
}

auth:bearer {
  token: {{mhsToken}}
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
  test("alasan NIM sendiri", function () {
    expect(res.getBody().reason).to.contain("NIM sendiri");
  });
}
