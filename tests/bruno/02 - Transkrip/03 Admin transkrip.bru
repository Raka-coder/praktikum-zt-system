meta {
  name: 03 Admin lihat transkrip
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/transkrip/{{nimSelf}}
  body: none
  auth: bearer
}

headers {
  X-Device-ID: DEV-ADMIN-01
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("nim sesuai", function () {
    expect(String(res.getBody().nim)).to.equal("2024001");
  });
}
