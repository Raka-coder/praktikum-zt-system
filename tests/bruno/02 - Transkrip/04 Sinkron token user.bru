meta {
  name: 04 Sinkron dengan token user (ditolak)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/transkrip/sinkron
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Device-ID: DEV-DOSEN-01
}

auth:bearer {
  token: {{dosenToken}}
}

body:json {
  {
    "kode": "{{kelasKode}}"
  }
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
  test("hanya service", function () {
    expect(res.getBody().reason).to.contain("hanya untuk service");
  });
}
