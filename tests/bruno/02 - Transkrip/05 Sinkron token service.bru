meta {
  name: 05 Sinkron dengan token service
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/transkrip/sinkron
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{serviceToken}}
}

body:json {
  {
    "kode": "{{kelasKode}}"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("jumlah baris tersinkron", function () {
    expect(res.getBody().synced).to.be.greaterThan(0);
  });
}
