meta {
  name: 02 POST service transkrip tanpa gateway secret
  type: http
  seq: 2
}

post {
  url: {{transkripServiceUrl}}/transkrip/sinkron
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "kode": "{{kelasKode}}"
  }
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
  test("akses langsung ditolak", function () {
    expect(res.getBody().reason).to.contain("akses langsung");
  });
}
