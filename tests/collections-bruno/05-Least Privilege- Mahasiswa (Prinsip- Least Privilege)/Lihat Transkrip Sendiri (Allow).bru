meta {
  name: Lihat Transkrip Sendiri (Allow)
  type: http
  seq: 1
}

get {
  url: http://127.0.0.1:3100/transkrip/2024001
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{mhsToken}}
  X-Device-ID: DEV-MHS-01
}

auth:bearer {
  token: {{mhsToken}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
}
