meta {
  name: Akses Langsung dengan Secret Tapi Tanpa Token (Deny)
  type: http
  seq: 2
}

get {
  url: http://127.0.0.1:3001/nilai
  body: none
  auth: none
}

headers {
  X-Gateway-Secret: {{process.env.GATEWAY_SECRET}}
  X-Device-ID: DEV-MHS-01
  Content-Type: application/json
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
}
